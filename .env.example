DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Supabase (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# OpenAI (platform.openai.com/api-keys) — powers AI category suggestions on
# import. Required locally AND as a Vercel project environment variable
# (Project Settings > Environment Variables) — it is never picked up from
# this .env file in production. Without it, imports still work; they just
# fall back to manual category selection.
OPENAI_API_KEY="sk-..."
