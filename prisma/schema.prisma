generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  transactions        Transaction[]
  budgetProfile       BudgetProfile?
  categories          Category[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  ENTRADA
  SAIDA
}

// RECEITA is used for Entrada (income) categories and doesn't participate
// in the budget's distribution — the budget splits what you do with your
// income across the other four, a personal/household budget structure
// (not an accounting/business cost split) mirroring the reference
// spreadsheet's "Orçamento de Gastos" sheet: Essenciais, Não Essenciais,
// Financiamentos (debt/financing) and Investimentos.
enum Classification {
  RECEITA
  ESSENCIAIS
  NAO_ESSENCIAIS
  FINANCIAMENTOS
  INVESTIMENTOS
}

// Categories belong to a single user and are fully editable by them
// (name, classification, active/inactive) — unlike Classification, which
// is a fixed, system-defined set. `isActive: false` is a soft delete: the
// category stops being offered for new lançamentos, but existing
// Transactions/BudgetCategoryAllocation rows that reference it are never
// touched, so history stays intact.
//
// The same concept name can exist under more than one Classification for
// the same user (e.g. "Pets" as both Essencial and Não Essencial) — each
// is its own row with its own id, distinguished in the UI as
// "Pets — Essencial" / "Pets — Não Essencial" (see
// src/lib/category-display.ts). The unique constraint below reflects
// that: two categories can share a name, but not the same
// (name, type, classification) triple.
model Category {
  id             String          @id @default(cuid())
  userId         String
  name           String
  type           TransactionType
  classification Classification
  order          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  budgetAllocations BudgetCategoryAllocation[]

  @@unique([userId, name, type, classification])
  @@index([userId])
}

model Transaction {
  id             String          @id @default(cuid())
  userId         String
  type           TransactionType
  amountCents    Int
  description    String
  categoryId     String
  classification Classification
  date           DateTime
  note           String?
  createdAt      DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, date])
}

// One profile per user, holding their monthly reference income (manually
// declared — see AGENTS.md stage 3 spec: never recalculated from actual
// transactions).
model BudgetProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  monthlyIncomeCents Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classificationAllocations BudgetClassificationAllocation[]
  categoryAllocations       BudgetCategoryAllocation[]
}

// Level 1 of the budget: how much of the income (%) goes to each
// Classification. `monthKey` is either the literal "default" (the
// standing budget applied to every month) or "YYYY-MM" for a one-off
// override of that specific month — never both at once for the same
// classification, enforced by the unique constraint below.
model BudgetClassificationAllocation {
  id              String         @id @default(cuid())
  budgetProfileId String
  classification  Classification
  percentage      Int
  monthKey        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, classification, monthKey])
  @@index([budgetProfileId, monthKey])
}

// Level 2 of the budget: how much of its parent Classification's amount
// (%) goes to each Category within it. Same "default" vs "YYYY-MM"
// convention as above.
model BudgetCategoryAllocation {
  id              String   @id @default(cuid())
  budgetProfileId String
  categoryId      String
  percentage      Int
  monthKey        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, categoryId, monthKey])
  @@index([budgetProfileId, monthKey])
}
