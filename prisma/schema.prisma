generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  transactions        Transaction[]
  transactionSeries   TransactionSeries[]
  budgetProfile       BudgetProfile?
  categories          Category[]
  paymentMethods      PaymentMethod[]
  tags                Tag[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NEUTRO is for money movements that are neither real income nor a real
// expense — a credit-card bill payment, a reimbursement, a transfer
// between your own accounts. Purely organizational: it never appears in
// the budget (see BUDGET_CLASSIFICATIONS in src/lib/budget-calc.ts,
// which intentionally excludes it the same way it already excludes
// RECEITA) and is excluded from the Entradas/Saídas/Saldo totals in
// src/lib/transactions.ts's summarize().
enum TransactionType {
  ENTRADA
  SAIDA
  NEUTRO
}

// Whether a Transaction represents money that has actually moved (PAGO)
// or a predicted future occurrence of a recurring/installment series
// that hasn't happened yet (NAO_PAGO). Every manually-entered or
// imported transaction is PAGO by definition — it only becomes NAO_PAGO
// when generated ahead of time by a TransactionSeries (see below) for a
// date that hasn't arrived yet.
enum TransactionStatus {
  PAGO
  NAO_PAGO
}

// RECORRENTE: open-ended (or bounded by TransactionSeries.endDate),
// same amount each occurrence — rent, a subscription, a utility bill.
// PARCELADO: a fixed, known-up-front number of installments of a
// purchase, all generated at once at creation time.
// A single Transaction can belong to at most one series, and a series
// is always exactly one of these two — never both at once.
enum SeriesType {
  RECORRENTE
  PARCELADO
}

// Only MENSAL exists today; the enum (rather than a free-text field)
// is what makes adding SEMANAL/ANUAL later a pure additive change, no
// redesign of TransactionSeries or the generation logic in
// src/lib/series.ts.
enum RecurrencePeriodicity {
  MENSAL
}

// RECEITA is used for Entrada (income) categories and doesn't participate
// in the budget's distribution — the budget splits what you do with your
// income across the other four, a personal/household budget structure
// (not an accounting/business cost split) mirroring the reference
// spreadsheet's "Orçamento de Gastos" sheet: Essenciais, Não Essenciais,
// Dívidas (debt/financing obligations — "Financiamento" is one of its
// Categories, not a Classification of its own) and Investimentos.
// NEUTRA (paired with TransactionType.NEUTRO above) is likewise excluded
// from the budget — organizational only.
enum Classification {
  RECEITA
  CUSTOS_OBRIGATORIOS
  PRAZERES_E_CONFORTOS
  INVESTIMENTOS
  NEUTRA
}

// Categories belong to a single user and are fully editable by them
// (name, classification, active/inactive) — unlike Classification, which
// is a fixed, system-defined set. `isActive: false` is a soft delete: the
// category stops being offered for new lançamentos, but existing
// Transactions/BudgetCategoryAllocation rows that reference it are never
// touched, so history stays intact.
//
// The same concept can exist under more than one Classification for the
// same user (e.g. "Pets - Essencial" and "Pets - Não Essencial") — each
// is its own row with its own id and its own full name (the default
// categories already bake " - Essencial" / " - Não Essencial" into the
// name itself, per the spreadsheet's naming convention, so they never
// look identical). src/lib/category-display.ts is a display-only
// fallback that disambiguates two categories a user creates with the
// exact same name in different Classifications, which this schema still
// allows. The unique constraint below reflects that: two categories can
// share a name, but not the same (name, type, classification) triple.
model Category {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  type           TransactionType
  classification Classification
  order          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]
  budgetAllocations BudgetCategoryAllocation[]

  @@unique([userId, name, type, classification])
  @@index([userId])
}

// A user-defined, freeform label for grouping otherwise-unrelated
// transactions under one occasional event — a trip, an outing, anything
// sporadic that cuts across the normal Category/Classification split
// (e.g. every expense from "Viagem Nordeste 2026", regardless of
// whether it's Alimentação, Transporte, or Lazer). Deliberately much
// lighter-weight than Category: no classification, no active/inactive
// state, real delete allowed (see PaymentMethod for the same reasoning).
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]

  @@unique([userId, name])
  @@index([userId])
}

// How a transaction was paid (Pix, cartão de crédito, dinheiro...) —
// optional, validated against this per-user list rather than a free-text
// field. Unlike Category, PaymentMethod and Tag are pure descriptive
// metadata, not part of a transaction's core financial identity, so a
// real delete (not soft-delete/inactivation) is safe: `onDelete: SetNull`
// on Transaction just clears the label from any historical rows instead
// of touching their amount/date/description/category.
model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  type              TransactionType
  amountCents       Int
  description       String?
  categoryId        String
  classification    Classification
  date              DateTime
  note              String?
  paymentMethodId   String?
  tagId             String?
  status            TransactionStatus @default(PAGO)
  seriesId          String?
  // Only set when seriesId points to a PARCELADO series — the "4" in
  // "4/12" (the total, 12, lives on the series itself). Always null for
  // a RECORRENTE series or a normal, series-less transaction.
  installmentNumber Int?
  // The bank/source's own unique id for this movement (OFX FITID today
  // — PDF and spreadsheet imports never have one, so this stays null
  // for them). Used to recognize an exact re-import of the same
  // statement and, when present, as the strongest signal when matching
  // an import row against a pending series occurrence — see
  // src/lib/import/reconciliation.ts.
  externalId        String?
  createdAt         DateTime          @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tag           Tag?               @relation(fields: [tagId], references: [id], onDelete: SetNull)
  series        TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  // At most one occurrence per series per date — both generators
  // (buildInstallmentRows, buildRecurringRows) only ever produce one
  // row per date within a series, so this is a correctness invariant,
  // not just incidental; it also lets ensureRecurringOccurrences'
  // createMany use skipDuplicates as a safety net against concurrent
  // page loads racing the same top-up (NULL seriesId rows never
  // conflict with each other, so normal transactions are unaffected).
  @@unique([seriesId, date])
  @@index([userId])
  @@index([userId, date])
  @@index([seriesId])
}

// The shared definition behind a recurring or installment series — see
// SeriesType. Never written to directly by the user beyond creation;
// its own transactions (below) are what actually show up in
// Lançamentos. `classification` is copied from `category.classification`
// at creation, same denormalization pattern Transaction already uses —
// never derived independently. `amountCents` is the value of EACH
// occurrence/installment (never a total) — see src/lib/series.ts.
// `isActive: false` means the series stopped generating new occurrences
// (cancelled, or cut short via "excluir este e os próximos") but its
// past transactions and this row are kept for history/context.
model TransactionSeries {
  id               String                 @id @default(cuid())
  userId           String
  seriesType       SeriesType
  type             TransactionType
  categoryId       String
  classification   Classification
  description      String?
  paymentMethodId  String?
  tagId            String?
  note             String?
  amountCents      Int
  // PARCELADO only — total number of installments (null for RECORRENTE).
  installmentCount Int?
  // RECORRENTE only — null for PARCELADO.
  periodicity      RecurrencePeriodicity?
  startDate        DateTime
  // RECORRENTE only, optional — an open-ended series has no endDate and
  // relies on the rolling top-up in src/lib/series.ts instead.
  endDate          DateTime?
  // RECORRENTE only — the date up to which occurrences have actually
  // been generated (initial creation, then advanced by each top-up).
  // Deliberately separate from MAX(Transaction.date): if it were
  // derived from existing rows instead, deleting the single latest
  // occurrence ("somente este") would make the top-up regenerate it on
  // the very next page load, since nothing would then exist past that
  // point. This field is the source of truth for "how far generation
  // has gotten," independent of which of those rows the user later
  // deleted.
  generatedUntil   DateTime?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tag           Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@index([userId])
}

// One profile per user, holding their monthly reference income (manually
// declared — see AGENTS.md stage 3 spec: never recalculated from actual
// transactions).
model BudgetProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  monthlyIncomeCents Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classificationAllocations BudgetClassificationAllocation[]
  categoryAllocations       BudgetCategoryAllocation[]
}

// Level 1 of the budget: how much of the income (%) goes to each
// Classification. `monthKey` is either the literal "default" (the
// standing budget applied to every month) or "YYYY-MM" for a one-off
// override of that specific month — never both at once for the same
// classification, enforced by the unique constraint below.
model BudgetClassificationAllocation {
  id              String         @id @default(cuid())
  budgetProfileId String
  classification  Classification
  percentage      Int
  monthKey        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, classification, monthKey])
  @@index([budgetProfileId, monthKey])
}

// Level 2 of the budget: how much of the TOTAL monthly income (%) is
// budgeted to each Category — computed directly against
// BudgetProfile.monthlyIncomeCents, not against its parent
// Classification's share (a Category's percentage is not a fraction of
// its Classification's percentage; the Classification's percentage is
// simply the sum of its Categories' percentages, and the two are
// tracked independently so a Classification can be under- or, until
// saved, over-distributed by its Categories). Same "default" vs
// "YYYY-MM" convention as above.
model BudgetCategoryAllocation {
  id              String   @id @default(cuid())
  budgetProfileId String
  categoryId      String
  percentage      Int
  monthKey        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, categoryId, monthKey])
  @@index([budgetProfileId, monthKey])
}

// Cross-user knowledge base of merchant -> category mappings, built up
// as the on-demand import categorizer (src/lib/import/merchant-resolver.ts)
// identifies genuinely new establishments via AI/research and the user
// confirms the suggestion without changing it. Deliberately no userId
// and no categoryId — Category is per-user, so this stores the
// canonical category identity (name + type + classification, same
// shape as src/lib/default-categories.ts) and gets resolved against
// each user's own matching category at lookup time. Grown
// conservatively (see the plan): one confirmation is enough to write
// an entry, but a user's own correction never touches this table —
// only their own history (Transaction rows), never global.
model MerchantKnowledge {
  id                     String          @id @default(cuid())
  normalizedPattern      String          @unique
  categoryName           String
  categoryType           TransactionType
  categoryClassification Classification
  sampleDescription      String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}
