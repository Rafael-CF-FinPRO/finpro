generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every existing account predates this — the default keeps every one of
// them behaving exactly as a CLIENTE (the only role that existed until
// now), see the migration that backfills `role` explicitly for extra
// safety. There is no public registration — every account is created by
// an ADMIN (a CONSULTOR or, if needed, a CLIENTE) or a CONSULTOR (a
// CLIENTE of their own), via src/app/actions/admin.ts / consultor.ts.
enum Role {
  ADMIN
  CONSULTOR
  CLIENTE
}

// INATIVO and BLOQUEADO currently behave identically (both block
// login/session, see getSession in src/lib/session.ts and loginAction)
// — kept as two labels rather than one boolean because a CONSULTOR may
// only set their own CLIENTE's status to ATIVO/INATIVO, while BLOQUEADO
// is reserved for an ADMIN (src/app/actions/consultor.ts's
// setClientStatusAction).
enum UserStatus {
  ATIVO
  INATIVO
  BLOQUEADO
}

// Whole-tab/module gating for the Admin Master (see SystemModule below)
// — ATIVA and EM_DESENVOLVIMENTO are distinguished only by who gets
// default access (everyone vs specifically-granted consultores);
// BLOQUEADA overrides any existing grant without deleting it, so
// flipping a module back to EM_DESENVOLVIMENTO/ATIVA later restores
// exactly what was there before (see the module-status migration note
// on ConsultantModuleAccess).
enum ModuleStatus {
  ATIVA
  EM_DESENVOLVIMENTO
  BLOQUEADA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Free-text, optional — shown/edited on "Meu Perfil" only.
  phone        String?
  role         Role     @default(CLIENTE)
  // A non-ATIVO user (any role) is treated as having no session at all
  // (see getSession in src/lib/session.ts) — kept on the same model
  // rather than a per-role table so the session check doesn't need a
  // second lookup.
  status       UserStatus @default(ATIVO)
  // Set only by a real, direct login (loginAction) — never touched by a
  // CONSULTOR/ADMIN impersonating this user, so it reflects the
  // CLIENTE's own actual usage for src/lib/consultor.ts's "dias desde o
  // último acesso".
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Self-relation: a CONSULTOR's own portfolio of CLIENTE accounts.
  // Null for a CLIENTE not managed by any consultor, and always null for
  // ADMIN/CONSULTOR themselves. onDelete: SetNull so removing a
  // consultor account (not exposed in the UI yet) never cascades into
  // deleting its clients' financial data.
  consultorId String?
  consultor   User?  @relation("ConsultorClientes", fields: [consultorId], references: [id], onDelete: SetNull)
  clientes    User[] @relation("ConsultorClientes")

  // No code path writes to this anymore — the public "esqueci minha
  // senha" flow was removed (passwords are now always set by a
  // superior). Left in place rather than dropped, to avoid an
  // unnecessary destructive migration on a live database.
  passwordResetTokens PasswordResetToken[]
  transactions        Transaction[]
  transactionSeries   TransactionSeries[]
  budgetProfile       BudgetProfile?
  categories          Category[]
  paymentMethods      PaymentMethod[]
  tags                Tag[]
  auditLogsAsConsultor AuditLog[] @relation("AuditConsultor")
  auditLogsAsCliente   AuditLog[] @relation("AuditCliente")

  // Whole-module access control (src/lib/modules.ts) — only ever
  // populated for a CONSULTOR (a grant row's consultorId always points
  // here); ADMIN and CLIENTE never have rows of their own.
  moduleAccess            ConsultantModuleAccess[]
  moduleAuditLogsAsAdmin     ModuleAuditLog[] @relation("ModuleAuditAdmin")
  moduleAuditLogsAsConsultor ModuleAuditLog[] @relation("ModuleAuditConsultor")

  // Gestão Patrimonial (src/lib/patrimonio.ts) — a completely separate,
  // self-contained module: never joined against Transaction/BudgetProfile.
  patrimonioAssets        PatrimonioAsset[]
  patrimonioLiabilities   PatrimonioLiability[]
  patrimonioProtections   PatrimonioProtection[]
  patrimonioConfirmations PatrimonioMonthlyConfirmation[]
  patrimonioValueChanges  PatrimonioValueChange[]

  @@index([consultorId])
}

// One row per write a CONSULTOR/ADMIN makes while impersonating a
// CLIENTE (src/lib/audit.ts) — never written for a CLIENTE's own direct
// usage. previousValue/newValue are deliberately loose JSON rather than
// typed per action: the set of audited actions is expected to grow, and
// this table only needs to be human-readable in a log, never queried by
// field.
model AuditLog {
  id            String   @id @default(cuid())
  consultorId   String
  clienteId     String
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  consultor User @relation("AuditConsultor", fields: [consultorId], references: [id], onDelete: Cascade)
  cliente   User @relation("AuditCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([consultorId])
  @@index([clienteId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A whole tab/module a role can access — never a button, field, or
// sub-action (see src/lib/modules.ts). Seeded once via a one-off script
// (not a migration): the 4 existing tabs as ATIVA, plus a placeholder
// "gestao_patrimonial" row as EM_DESENVOLVIMENTO with no page behind it
// yet — the infrastructure exists before the feature does.
model SystemModule {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String?
  status      ModuleStatus @default(ATIVA)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  consultantAccess ConsultantModuleAccess[]
  auditLogs        ModuleAuditLog[]
}

// One row per (consultor, module) — whether that CONSULTOR (and, by
// inheritance, every CLIENTE in their portfolio) has this module
// unlocked. Only consulted while the module's own status is
// EM_DESENVOLVIMENTO (src/lib/modules.ts's getAccessibleModuleKeys) —
// a row is never deleted when a module's global status changes to
// BLOQUEADA, so re-enabling it later (back to EM_DESENVOLVIMENTO)
// restores exactly the same set of consultores without re-granting.
model ConsultantModuleAccess {
  id          String   @id @default(cuid())
  consultorId String
  moduleId    String
  isEnabled   Boolean  @default(false)
  // id of the ADMIN who last changed this row — informational only,
  // the real trail is ModuleAuditLog below.
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consultor User         @relation(fields: [consultorId], references: [id], onDelete: Cascade)
  module    SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([consultorId, moduleId])
  @@index([moduleId])
}

// Admin Master's own audit trail for module management — deliberately
// separate from AuditLog (src/lib/audit.ts), whose consultorId AND
// clienteId are both required (it's specifically for a CONSULTOR/ADMIN
// acting inside a CLIENTE's environment). A module-management event
// never has a cliente, and a global status change doesn't even have a
// consultor, so reusing that table would mean loosening its existing
// NOT NULL columns — this new table just mirrors its shape instead.
model ModuleAuditLog {
  id            String   @id @default(cuid())
  adminId       String
  moduleId      String
  // null for a global status change (module.setStatus) — only set for
  // module.setConsultorAccess.
  consultorId   String?
  action        String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  admin     User         @relation("ModuleAuditAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  module    SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  consultor User?        @relation("ModuleAuditConsultor", fields: [consultorId], references: [id], onDelete: SetNull)

  @@index([moduleId])
  @@index([consultorId])
}

// NEUTRO is for money movements that are neither real income nor a real
// expense — a credit-card bill payment, a reimbursement, a transfer
// between your own accounts. Purely organizational: it never appears in
// the budget (see BUDGET_CLASSIFICATIONS in src/lib/budget-calc.ts,
// which intentionally excludes it the same way it already excludes
// RECEITA) and is excluded from the Entradas/Saídas/Saldo totals in
// src/lib/transactions.ts's summarize().
enum TransactionType {
  ENTRADA
  SAIDA
  NEUTRO
}

// Whether a Transaction represents money that has actually moved (PAGO)
// or a predicted future occurrence of a recurring/installment series
// that hasn't happened yet (NAO_PAGO). Every manually-entered or
// imported transaction is PAGO by definition — it only becomes NAO_PAGO
// when generated ahead of time by a TransactionSeries (see below) for a
// date that hasn't arrived yet.
enum TransactionStatus {
  PAGO
  NAO_PAGO
}

// RECORRENTE: open-ended (or bounded by TransactionSeries.endDate),
// same amount each occurrence — rent, a subscription, a utility bill.
// PARCELADO: a fixed, known-up-front number of installments of a
// purchase, all generated at once at creation time.
// A single Transaction can belong to at most one series, and a series
// is always exactly one of these two — never both at once.
enum SeriesType {
  RECORRENTE
  PARCELADO
}

// Only MENSAL exists today; the enum (rather than a free-text field)
// is what makes adding SEMANAL/ANUAL later a pure additive change, no
// redesign of TransactionSeries or the generation logic in
// src/lib/series.ts.
enum RecurrencePeriodicity {
  MENSAL
}

// RECEITA is used for Entrada (income) categories and doesn't participate
// in the budget's distribution — the budget splits what you do with your
// income across the other four, a personal/household budget structure
// (not an accounting/business cost split) mirroring the reference
// spreadsheet's "Orçamento de Gastos" sheet: Essenciais, Não Essenciais,
// Dívidas (debt/financing obligations — "Financiamento" is one of its
// Categories, not a Classification of its own) and Investimentos.
// NEUTRA (paired with TransactionType.NEUTRO above) is likewise excluded
// from the budget — organizational only.
enum Classification {
  RECEITA
  CUSTOS_OBRIGATORIOS
  PRAZERES_E_CONFORTOS
  INVESTIMENTOS
  NEUTRA
}

// Categories belong to a single user and are fully editable by them
// (name, classification, active/inactive) — unlike Classification, which
// is a fixed, system-defined set. `isActive: false` is a soft delete: the
// category stops being offered for new lançamentos, but existing
// Transactions/BudgetCategoryAllocation rows that reference it are never
// touched, so history stays intact.
//
// The same concept can exist under more than one Classification for the
// same user (e.g. "Pets - Essencial" and "Pets - Não Essencial") — each
// is its own row with its own id and its own full name (the default
// categories already bake " - Essencial" / " - Não Essencial" into the
// name itself, per the spreadsheet's naming convention, so they never
// look identical). src/lib/category-display.ts is a display-only
// fallback that disambiguates two categories a user creates with the
// exact same name in different Classifications, which this schema still
// allows. The unique constraint below reflects that: two categories can
// share a name, but not the same (name, type, classification) triple.
model Category {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  type           TransactionType
  classification Classification
  order          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]
  budgetAllocations BudgetCategoryAllocation[]

  @@unique([userId, name, type, classification])
  @@index([userId])
}

// A user-defined, freeform label for grouping otherwise-unrelated
// transactions under one occasional event — a trip, an outing, anything
// sporadic that cuts across the normal Category/Classification split
// (e.g. every expense from "Viagem Nordeste 2026", regardless of
// whether it's Alimentação, Transporte, or Lazer). Deliberately much
// lighter-weight than Category: no classification, no active/inactive
// state, real delete allowed (see PaymentMethod for the same reasoning).
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]

  @@unique([userId, name])
  @@index([userId])
}

// How a transaction was paid (Pix, cartão de crédito, dinheiro...) —
// optional, validated against this per-user list rather than a free-text
// field. Unlike Category, PaymentMethod and Tag are pure descriptive
// metadata, not part of a transaction's core financial identity, so a
// real delete (not soft-delete/inactivation) is safe: `onDelete: SetNull`
// on Transaction just clears the label from any historical rows instead
// of touching their amount/date/description/category.
model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSeries TransactionSeries[]

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  type              TransactionType
  amountCents       Int
  description       String?
  categoryId        String
  classification    Classification
  date              DateTime
  note              String?
  paymentMethodId   String?
  tagId             String?
  status            TransactionStatus @default(PAGO)
  seriesId          String?
  // Only set when seriesId points to a PARCELADO series — the "4" in
  // "4/12" (the total, 12, lives on the series itself). Always null for
  // a RECORRENTE series or a normal, series-less transaction.
  installmentNumber Int?
  // The bank/source's own unique id for this movement (OFX FITID today
  // — PDF and spreadsheet imports never have one, so this stays null
  // for them). Used to recognize an exact re-import of the same
  // statement and, when present, as the strongest signal when matching
  // an import row against a pending series occurrence — see
  // src/lib/import/reconciliation.ts.
  externalId        String?
  createdAt         DateTime          @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tag           Tag?               @relation(fields: [tagId], references: [id], onDelete: SetNull)
  series        TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  // At most one occurrence per series per date — both generators
  // (buildInstallmentRows, buildRecurringRows) only ever produce one
  // row per date within a series, so this is a correctness invariant,
  // not just incidental; it also lets ensureRecurringOccurrences'
  // createMany use skipDuplicates as a safety net against concurrent
  // page loads racing the same top-up (NULL seriesId rows never
  // conflict with each other, so normal transactions are unaffected).
  @@unique([seriesId, date])
  @@index([userId])
  @@index([userId, date])
  @@index([seriesId])
}

// The shared definition behind a recurring or installment series — see
// SeriesType. Never written to directly by the user beyond creation;
// its own transactions (below) are what actually show up in
// Lançamentos. `classification` is copied from `category.classification`
// at creation, same denormalization pattern Transaction already uses —
// never derived independently. `amountCents` is the value of EACH
// occurrence/installment (never a total) — see src/lib/series.ts.
// `isActive: false` means the series stopped generating new occurrences
// (cancelled, or cut short via "excluir este e os próximos") but its
// past transactions and this row are kept for history/context.
model TransactionSeries {
  id               String                 @id @default(cuid())
  userId           String
  seriesType       SeriesType
  type             TransactionType
  categoryId       String
  classification   Classification
  description      String?
  paymentMethodId  String?
  tagId            String?
  note             String?
  amountCents      Int
  // PARCELADO only — total number of installments (null for RECORRENTE).
  installmentCount Int?
  // RECORRENTE only — null for PARCELADO.
  periodicity      RecurrencePeriodicity?
  startDate        DateTime
  // RECORRENTE only, optional — an open-ended series has no endDate and
  // relies on the rolling top-up in src/lib/series.ts instead.
  endDate          DateTime?
  // RECORRENTE only — the date up to which occurrences have actually
  // been generated (initial creation, then advanced by each top-up).
  // Deliberately separate from MAX(Transaction.date): if it were
  // derived from existing rows instead, deleting the single latest
  // occurrence ("somente este") would make the top-up regenerate it on
  // the very next page load, since nothing would then exist past that
  // point. This field is the source of truth for "how far generation
  // has gotten," independent of which of those rows the user later
  // deleted.
  generatedUntil   DateTime?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tag           Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@index([userId])
}

// One profile per user, holding their monthly reference income (manually
// declared — see AGENTS.md stage 3 spec: never recalculated from actual
// transactions).
model BudgetProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  monthlyIncomeCents Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classificationAllocations BudgetClassificationAllocation[]
  categoryAllocations       BudgetCategoryAllocation[]
}

// Level 1 of the budget: how much of the income (%) goes to each
// Classification — never set directly by the user, always computed
// server-side as the sum of that Classification's own Categories'
// percentages below (src/app/actions/budget.ts's
// saveBudgetDistributionAction) and persisted here purely so the rest
// of the app (Dashboard, compliance scoring, etc.) can keep reading a
// per-classification percentage without re-deriving it every time.
// `monthKey` is either the literal "default" (the standing budget
// applied to every month) or "YYYY-MM" for a one-off override of that
// specific month — never both at once for the same classification,
// enforced by the unique constraint below.
model BudgetClassificationAllocation {
  id              String         @id @default(cuid())
  budgetProfileId String
  classification  Classification
  // Half-percentage-point steps (12.5, not just 12 or 13) — Float
  // rather than Int/Decimal so it stays a plain JS number everywhere
  // it's already used in arithmetic, no Decimal.js wrapper to unwrap.
  // Always a multiple of 0.5, enforced in src/lib/validation.ts.
  percentage      Float
  monthKey        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, classification, monthKey])
  @@index([budgetProfileId, monthKey])
}

// Level 2 of the budget — and the only level the user actually sets: how
// much of the TOTAL monthly income (%) is budgeted to each Category,
// computed directly against BudgetProfile.monthlyIncomeCents, never as
// a fraction of its parent Classification's percentage (that one is
// just the sum of these, see BudgetClassificationAllocation above). A
// Category is free to sit at 0% — nothing requires every category, or
// even every classification, to be distributed; the only real ceiling
// is that every Category together can never exceed 100%. Same
// "default" vs "YYYY-MM" convention as above.
model BudgetCategoryAllocation {
  id              String   @id @default(cuid())
  budgetProfileId String
  categoryId      String
  // Same half-percentage-point convention as
  // BudgetClassificationAllocation.percentage above.
  percentage      Float
  monthKey        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgetProfile BudgetProfile @relation(fields: [budgetProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetProfileId, categoryId, monthKey])
  @@index([budgetProfileId, monthKey])
}

// Cross-user knowledge base of merchant -> category mappings, built up
// as the on-demand import categorizer (src/lib/import/merchant-resolver.ts)
// identifies genuinely new establishments via AI/research and the user
// confirms the suggestion without changing it. Deliberately no userId
// and no categoryId — Category is per-user, so this stores the
// canonical category identity (name + type + classification, same
// shape as src/lib/default-categories.ts) and gets resolved against
// each user's own matching category at lookup time. Grown
// conservatively (see the plan): one confirmation is enough to write
// an entry, but a user's own correction never touches this table —
// only their own history (Transaction rows), never global.
model MerchantKnowledge {
  id                     String          @id @default(cuid())
  normalizedPattern      String          @unique
  categoryName           String
  categoryType           TransactionType
  categoryClassification Classification
  sampleDescription      String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// ============================================================
// Gestão Patrimonial — a self-contained module (src/lib/patrimonio.ts).
// Never joined against Transaction/Category/BudgetProfile: this first
// version tracks a user's own bens/dívidas/proteção independently of
// the cash-flow side of the app. Gated behind the "gestao_patrimonial"
// SystemModule (src/lib/modules.ts) — nobody sees this tab until an
// ADMIN explicitly liberates it for their consultor.
// ============================================================

enum PatrimonioAssetCategory {
  FINANCEIRO
  BEM_MOVEL
  BEM_IMOVEL
  INTANGIVEL
  COLECIONAVEL
}

enum PatrimonioLiabilityCategory {
  EMPRESTIMO_DIVIDA
  FINANCIAMENTO
  CONSORCIO
  OUTRO
}

enum PatrimonioUsageType {
  USO_PESSOAL
  GERADOR_RENDA
}

enum PatrimonioLocation {
  ONSHORE
  OFFSHORE
}

enum PatrimonioLiquidity {
  ALTA
  MEDIA
  BAIXA
}

// MANUAL: the value only ever changes when the user confirms a new one
// for a given month (src/lib/patrimonio.ts's effectiveValueFor).
// PROJECAO_AUTOMATICA: absent a confirmation for a given month, the
// value is compounded monthly from annualRatePct off the last known
// base (a previous confirmation, or currentValueCents/createdAt if
// there's never been one).
enum PatrimonioUpdateMethod {
  MANUAL
  PROJECAO_AUTOMATICA
}

// One row per bem cadastrado, across all 5 categories from the
// spreadsheet — a single model with a category discriminator (same
// pattern Category/Transaction already use for their own type/
// classification split) rather than 5 near-identical tables. Fields
// that only apply to some categories (isRented/rentNetValueCents:
// Bens Imóveis; purchaseDate/purchaseValueCents: everything except
// Financeiro) are simply left null where not applicable — the create/
// edit form only shows the fields relevant to the category being
// cadastrado. No hard delete anywhere in this module — isActive is the
// only way to retire an item, so a month's confirmation/projection
// history is never orphaned.
model PatrimonioAsset {
  id                 String                   @id @default(cuid())
  userId             String
  category           PatrimonioAssetCategory
  name               String
  currentValueCents  Int
  usageType          PatrimonioUsageType?
  location           PatrimonioLocation?
  liquidity          PatrimonioLiquidity?
  updateMethod       PatrimonioUpdateMethod   @default(MANUAL)
  // Signed — a depreciating bem móvel (a car) is a legitimate negative
  // annual rate, not an error.
  annualRatePct      Float?
  // Free-text index/description shown for reference only, never parsed
  // — "IPCA + 5% a.a", "CDI", "FIPEZAP" (the spreadsheet's "Performance"
  // column for Financeiro, and the correction index for Bens Imóveis).
  rateLabel          String?
  purchaseDate       DateTime?
  purchaseValueCents Int?
  // Bens Imóveis only.
  isRented           Boolean?
  rentNetValueCents  Int?
  isActive           Boolean                  @default(true)
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  user          User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  liabilities   PatrimonioLiability[]
  confirmations PatrimonioMonthlyConfirmation[]
  valueChanges  PatrimonioValueChange[]

  @@index([userId, category])
}

// Same discriminator pattern as PatrimonioAsset, covering all 4
// liability categories. linkedAssetId is optional (spreadsheet's
// "Vinculado a algum bem?") — e.g. a financiamento tied to the imóvel
// it financed; onDelete: SetNull so deleting (deactivating, in
// practice — nothing here is ever hard-deleted) the linked asset never
// cascades into the liability itself.
model PatrimonioLiability {
  id                    String                       @id @default(cuid())
  userId                String
  category              PatrimonioLiabilityCategory
  name                  String
  currentBalanceCents   Int
  installmentValueCents Int?
  remainingInstallments Int?
  // Free-text (SAC, PRICE...) — not modeled as an enum since this is
  // informational only, no amortization simulator in this version.
  amortization          String?
  cetPct                Float?
  correctionIndex       String?
  // Consórcio only.
  administrationFeePct  Float?
  creditValueCents      Int?
  // "Administradora/Instituição" — e.g. "Porto Seguro", "Rodobens".
  institutionName       String?
  // "Valor Já Pago no Controle" — what's actually been paid into the
  // consórcio so far, distinct from currentBalanceCents ("Saldo a
  // Pagar", what's still owed) and creditValueCents (the letter's face
  // value). Required for CONSORCIO (validation.ts's superRefine).
  paidValueCents        Int?
  isContemplated        Boolean?
  contemplationDate     DateTime?
  // Outros Passivos only — free-text type, since this category is
  // explicitly the catch-all for whatever doesn't fit the other three.
  liabilityType         String?
  linkedAssetId         String?
  startDate             DateTime?
  expectedEndDate       DateTime?
  dueDate               DateTime?
  // A single attached document (contrato, cédula, extrato...) per
  // liability — stored as bytes directly in Postgres rather than a new
  // object-storage integration (nothing of the sort exists in this
  // project yet, and one document per item never justifies one).
  // documentData is null exactly when no document is attached.
  documentFileName      String?
  documentMimeType      String?
  documentFileSize      Int?
  documentData          Bytes?
  isActive              Boolean                      @default(true)
  notes                 String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  user          User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAsset   PatrimonioAsset?                 @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  confirmations PatrimonioMonthlyConfirmation[]
  valueChanges  PatrimonioValueChange[]

  @@index([userId, category])
  @@index([linkedAssetId])
}

// The 16 suggested elements (Seguro de Vida, Holding, Reserva de
// Emergência...) are seeded per user (src/lib/default-patrimonio-protections.ts)
// but `element` is free text, not an enum — the user can add their own
// beyond the suggested list. "Complementação necessária" from the spec
// is deliberately not a stored column: it's just idealValueCents -
// currentValueCents, computed at read time in src/lib/patrimonio.ts.
model PatrimonioProtection {
  id                String   @id @default(cuid())
  userId            String
  element           String
  objective         String?
  currentValueCents Int?
  idealValueCents   Int?
  isNeeded          Boolean?
  isCovered         Boolean?
  // Same single-document-per-item convention as PatrimonioLiability
  // (a seguro/apólice/previdência's own contract or apólice).
  documentFileName  String?
  documentMimeType  String?
  documentFileSize  Int?
  documentData      Bytes?
  notes             String?
  order             Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A sparse ledger — a row only exists when the user explicitly
// confirms/adjusts a bem/dívida's value for one specific month.
// Everything else (a month nobody has touched) is computed on the fly
// by src/lib/patrimonio.ts's effectiveValueFor, projecting forward from
// the most recent confirmation (or the cadastro's own currentValueCents
// if there's never been one) — so the full monthly history is always
// reconstructible without needing to eagerly materialize a snapshot
// row for every month for every user. Exactly one of assetId/liabilityId
// is set per row; both `@@unique` constraints hold independently since
// Postgres treats NULLs as distinct for uniqueness purposes.
model PatrimonioMonthlyConfirmation {
  id          String   @id @default(cuid())
  userId      String
  monthKey    String
  assetId     String?
  liabilityId String?
  valueCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     PatrimonioAsset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  liability PatrimonioLiability? @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@unique([assetId, monthKey])
  @@unique([liabilityId, monthKey])
  @@index([userId, monthKey])
}

// Only MANUAL is ever written today — "Editar e atualizar" logs one row
// here whenever the user changes an item's Valor Atual/Saldo Devedor (a
// pure cadastral edit with no value change writes nothing here). The
// other three exist so a future automatic-projection feature has
// somewhere to log its own writes without a schema change — not wired
// up yet (see src/lib/patrimonio.ts's effectiveValueFor, which computes
// PROJETADO/CONFIRMADO purely in memory from PatrimonioMonthlyConfirmation
// and never touches this table).
enum PatrimonioValueChangeOrigin {
  MANUAL
  AUTOMATICA
  PROJETADA
  CONFIRMADA_MANUALMENTE
}

// A pure append-only audit trail of value changes — never updated or
// deleted, unlike PatrimonioMonthlyConfirmation (which upserts one row
// per item per month for the projection engine). This is a different
// concern: "what did this item's value used to be, and when/who changed
// it," independent of any particular month. changedByUserId is the
// actual actor (session.realUserId) rather than the data owner — the
// same distinction ConsultantModuleAccess.updatedBy already draws — so
// a consultor editing a cliente's cadastro while impersonating them is
// recorded accurately; deliberately not a relation (informational only,
// matches that same precedent) so this table never needs its own
// migration if the User model's shape changes.
model PatrimonioValueChange {
  id                 String                      @id @default(cuid())
  userId             String
  assetId            String?
  liabilityId        String?
  previousValueCents Int
  newValueCents      Int
  origin             PatrimonioValueChangeOrigin @default(MANUAL)
  changedByUserId    String
  createdAt          DateTime                    @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     PatrimonioAsset?     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  liability PatrimonioLiability? @relation(fields: [liabilityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId])
  @@index([liabilityId])
}
